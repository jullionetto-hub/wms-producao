{
  "//": "Etapa 1 da migracao para TypeScript: so CHECA o JavaScript do servidor, nao compila nem gera arquivo (noEmit). O app continua rodando 'node index.js' como antes.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": ["index.ts", "src/**/*.ts", "routes/**/*.ts", "lib/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "public", "tests"]
}
